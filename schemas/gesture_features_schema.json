{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gesture Features Schema",
  "description": "手势分析器输出的手势特征数据结构",
  "type": "object",
  "required": [
    "source",
    "frame_count_total",
    "frame_count_processed",
    "gesture_statistics",
    "gesture_classification",
    "dimension_scores",
    "timestamp"
  ],
  "properties": {
    "source": {
      "type": "string",
      "description": "输入视频路径"
    },
    "frame_count_total": {
      "type": "integer",
      "minimum": 0,
      "description": "视频总帧数"
    },
    "frame_count_processed": {
      "type": "integer",
      "minimum": 0,
      "description": "检测到手部关键点的帧数（送入 HandLandmarker 后成功检测到手部的帧）"
    },
    "hand_presence_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "手部出现时间占比"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "视频时长（秒）"
    },
    "gesture_statistics": {
      "type": "object",
      "required": ["gestures_per_minute", "gesture_variety_count"],
      "properties": {
        "gestures_per_minute": {
          "type": "number",
          "minimum": 0,
          "description": "每分钟手势次数"
        },
        "gesture_variety_count": {
          "type": "integer",
          "minimum": 0,
          "description": "手势种类数"
        },
        "total_gestures_detected": {
          "type": "integer",
          "minimum": 0,
          "description": "检测到的手势总数"
        },
        "dominant_hand": {
          "type": "string",
          "enum": ["left", "right", "both", "unknown"],
          "description": "主导手势手。当前实现仅输出 both/right/unknown，left 为未来扩展预留"
        }
      }
    },
    "gesture_classification": {
      "type": "object",
      "required": ["open_palm", "closed_fist", "pointing", "other"],
      "description": "手势分类统计（4 种类型始终输出，即使 count=0）",
      "properties": {
        "open_palm": {
          "type": "object",
          "properties": {
            "count": { "type": "integer" },
            "ratio": { "type": "number" }
          }
        },
        "closed_fist": {
          "type": "object",
          "properties": {
            "count": { "type": "integer" },
            "ratio": { "type": "number" }
          }
        },
        "pointing": {
          "type": "object",
          "properties": {
            "count": { "type": "integer" },
            "ratio": { "type": "number" }
          }
        },
        "other": {
          "type": "object",
          "properties": {
            "count": { "type": "integer" },
            "ratio": { "type": "number" }
          }
        }
      }
    },
    "hand_movement": {
      "type": "object",
      "properties": {
        "mean_velocity": { "type": "number" },
        "max_velocity": { "type": "number" },
        "movement_range_x": { "type": "number" },
        "movement_range_y": { "type": "number" },
        "movement_smoothness": { "type": "number" }
      }
    },
    "dimension_scores": {
      "type": "object",
      "required": ["gesture_score"],
      "properties": {
        "gesture_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "手势得分"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "description": "分析时间戳 (ISO 8601)"
    }
  }
}
